# Optional GitHub token for higher GitHub API rate limits.
GITHUB_TOKEN=

# LLM provider: mock | openai_compatible | ollama | cohere | alemplus
LLM_PROVIDER=mock

# OpenAI-compatible
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=
LLM_MODEL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cohere
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# AlemPlus
ALEMPLUS_BASE_URL=
ALEMPLUS_API_KEY=
ALEMPLUS_MODEL=
